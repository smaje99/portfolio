---
import BlogPostPage from '@/components/BlogPostPage.astro';
import { getPublishedLocalBlogEntries } from '@/data/blog';

export async function getStaticPaths() {
  const entries = await getPublishedLocalBlogEntries('en');

  return entries.map((entry) => ({
    params: { slug: entry.data.slug.replace(/\.en$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<BlogPostPage entry={entry} locale="en" />
