---
import CalendarIcon from "../icons/CalendarIcon.astro";
import { type Experience } from "../types/experience";
import { formatDateRange } from '../utils/date';
import { capitalizeFirstLetter } from '../utils/string';
import type { Locale } from '../i18n/site';

interface Props extends Experience {
  locale: Locale;
  labels: {
    current: string;
    present: string;
  };
}

const {
  position,
  company,
  description,
  startDate,
  endDate,
  typeOfEmployment,
  link,
  current,
  skills,
  locale,
  labels,
} = Astro.props;
---

<li class="experience-item">
  <span>
    <CalendarIcon />
  </span>
  <div class="experience-copy">
    <div class="experience-header">
      <h3>
        {position}
        {current ? <span>{labels.current}</span> : null}
      </h3>
      <p>{company}</p>
    </div>
    <p class="experience-meta">
      <time datetime={startDate.toISOString()}>
        {capitalizeFirstLetter(formatDateRange(startDate, endDate, locale, labels.present))}
      </time>
      <span aria-hidden="true">·</span>
      <span>{typeOfEmployment}</span>
    </p>
    <p class="experience-description">{description}</p>
    {skills.length ? (
      <ul class="experience-skills">
        {skills.map((skill) => (
          <li>{skill}</li>
        ))}
      </ul>
    ) : null}
  </div>
  {link ? <a href="#" /> : null}
</li>

<style>
  .experience-item {
    margin-inline-start: 1.5rem;
    margin-bottom: 2.5rem;

    & > span {
      position: absolute;
      inset-inline-start: -0.75rem;

      width: 1.5rem;
      height: 1.5rem;

      display: flex;
      justify-content: center;
      align-items: center;

      background-color: var(--primary);

      border-radius: calc(infinity * 1px);
      box-shadow: 0 0 0 8px var(--panel-scrim);

      & > svg {
        width: 0.625rem;
        height: 0.625rem;

        color: var(--primary-foreground);
      }
    }

    & .experience-copy {
      display: grid;
      gap: 0.75rem;
    }

    & .experience-header {
      display: grid;
      gap: 0.25rem;

      & > h3 {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 1.125rem;
        line-height: 1.5rem;
        font-weight: 600;
        color: var(--foreground);

        & > span {
          font-size: 0.875rem;
          line-height: 1.25rem;
          padding: 0.125rem 0.625rem;
          border: 1px solid var(--border-primary);
          border-radius: 999px;
          background-color: var(--surface-primary);
          color: var(--foreground);
        }
      }

      & > p {
        margin: 0;
        font-size: 0.975rem;
        line-height: 1.5rem;
        color: var(--secondary-foreground);
      }
    }

    & .experience-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.4;
      color: var(--muted-foreground);

      & > time {
        display: inline;
      }
    }

    & .experience-description {
      margin: 0;
      font-size: 1rem;
      line-height: 1.5rem;
      font-weight: 400;
      color: var(--secondary-foreground);
    }

    & .experience-skills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;

      & > li {
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--border-accent);
        border-radius: 999px;
        background: var(--surface-accent);
        color: var(--foreground);
        font-size: 0.85rem;
        line-height: 1.2;
      }
    }
  }
</style>
