---
import BasePage from '@/components/BasePage.astro';
import ProjectsGrid from '@/components/ProjectsGrid.astro';
import SectionContainer from '@/components/SectionContainer.astro';
import SectionPage from '@/components/SectionPage.astro';
import { getProjects } from '@/data/projects';
import { getHomeCopy, type Locale } from '@/i18n/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = getHomeCopy(locale);
const projects = getProjects(locale);
---

<BasePage
  locale={locale}
  slug="projects"
  title={`${copy.projectsSection.pageTitle} | ${copy.title}`}
  description={copy.projectsSection.pageDescription}
>
  <SectionContainer>
    <SectionPage
      headingId="projects-title"
      number="01"
      title={copy.projectsSection.pageTitle}
      intro={copy.projectsSection.intro}
    >
      <ProjectsGrid projects={projects} />
    </SectionPage>
  </SectionContainer>
</BasePage>
