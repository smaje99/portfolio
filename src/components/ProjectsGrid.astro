---
type Project = {
  slug: string;
  title: string;
  description: string;
  focus: string;
  tags: string[];
};

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="projects-grid">
  {projects.map((project) => (
    <article class="project-card">
      <p>{project.focus}</p>
      <h3>{project.title}</h3>
      <p class="project-description">{project.description}</p>
      <ul class="project-tags">
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </article>
  ))}
</div>

<style>
  .projects-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    min-height: 100%;
    padding: 1.25rem;
    display: grid;
    gap: 0.85rem;
    border: 1px solid rgb(75 131 140 / 24%);
    border-radius: 1.5rem;
    background: rgb(4 25 30 / 42%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 3%);
  }

  .project-card > p:first-child {
    margin: 0;
    color: var(--brand-aqua);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-card > h3,
  .project-card > h4 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--foreground);
  }

  .project-description {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.65;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-tags > li {
    padding: 0.35rem 0.7rem;
    border: 1px solid rgb(127 221 211 / 25%);
    border-radius: 999px;
    background: rgb(127 221 211 / 10%);
    color: var(--foreground);
    font-size: 0.85rem;
    line-height: 1.2;
  }

  @media (width <= 720px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
