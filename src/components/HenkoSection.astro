---
import type { getHomeCopy } from '@/i18n/site';
import LinkedInIcon from '@/icons/LinkedInIcon.astro';

interface Props {
  copy: ReturnType<typeof getHomeCopy>['henkoSection'];
}

const { copy } = Astro.props;
---

<section id="henko" class="henko-panel" aria-labelledby="henko-title">
  <div class="henko-frame">
    <div class="henko-visually-hidden">
      <h2 id="henko-title">{copy.title}</h2>
      <p>{copy.legalName}</p>
    </div>

    <header class="henko-header">
      <span class="henko-index" aria-hidden="true">02</span>
      <div class="henko-lockup">
        <div class="henko-logo-stack">
          <img
            src="/henko.svg"
            alt={copy.logoAlt}
            width="930"
            height="340"
            class="henko-logo"
          />
          <p class="henko-tagline">{copy.tagline}</p>
        </div>
        <div class="henko-cta">
          <a
            class="henko-cta-link"
            href="https://www.linkedin.com/company/henko-consulting-and-technology-services/home"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.linkedinLabel}
          >
            <LinkedInIcon aria-hidden="true" width="18" height="18" />
            <span>{copy.ctaLabel}</span>
          </a>
          <a
            class="henko-cta-link"
            href="https://henkoconsulting.com.co/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.websiteLabel}
          >
            <img
              src="/henko-mark.svg"
              alt=""
              width="18"
              height="18"
              class="henko-cta-mark"
            />
            <span>{copy.websiteLabel}</span>
          </a>
        </div>
      </div>
    </header>

    <main class="henko-body">
      <div class="henko-intro">
        {copy.intro.map((paragraph) => (
          <p>
            {paragraph.map((part) =>
              part.emphasis === 'strong' ? (
                <strong>{part.text}</strong>
              ) : part.emphasis === 'em' ? (
                <em>{part.text}</em>
              ) : (
                part.text
              ),
            )}
          </p>
        ))}
      </div>
    </main>

    <footer class="henko-footer">
      <div class="henko-areas">
        <h3>{copy.areasLabel}</h3>
        <ul>
          {copy.areas.map((area) => <li>{area}</li>)}
        </ul>
      </div>
    </footer>
  </div>
</section>

<style>
  .henko-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-primary);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 92% 8%, var(--glow-primary-soft), transparent 0 18rem),
      var(--gradient-panel);
    box-shadow: var(--shadow-elevated);
    backdrop-filter: blur(16px);
    scroll-margin-block-start: clamp(7rem, 28vh, 16rem);
  }

  .henko-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--gradient-panel-overlay-aqua);
    opacity: 0.9;
  }

  .henko-frame {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    padding: 1.75rem;
  }

  .henko-header {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }

  .henko-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .henko-body {
    display: block;
  }

  .henko-footer {
    display: grid;
    gap: 0.65rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--border-faint);
  }

  .henko-lockup {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .henko-logo-stack {
    display: grid;
    gap: 1rem;
  }

  .henko-logo {
    display: block;
    width: min(100%, 34rem);
    height: auto;
    filter: var(--shadow-brand);
  }

  .henko-index {
    width: 4rem;
    margin: 0;
    color: var(--text-highlight);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  .henko-tagline {
    max-width: 36ch;
    margin: 0;
    color: var(--text-highlight);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .henko-cta {
    display: grid;
    gap: 0.85rem;
    justify-items: start;
    align-self: end;
  }

  .henko-cta-link {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    color: var(--text-highlight);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.5;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .henko-cta-link:hover {
    color: var(--foreground);
    transform: translateX(2px);
  }

  .henko-cta-link :global(svg) {
    display: block;
    flex: 0 0 1.1rem;
    width: 1.1rem;
    height: 1.1rem;
  }

  .henko-cta-mark {
    display: block;
    flex: 0 0 1.1rem;
    width: 1.1rem;
    height: 1.1rem;
    object-fit: contain;
  }

  .henko-intro {
    display: grid;
    gap: 1rem;
    max-width: 62rem;
    margin: 0;
    color: var(--text-soft);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.78;
    text-wrap: pretty;
  }

  .henko-intro p {
    margin: 0;
  }

  .henko-intro strong {
    color: var(--foreground);
    font-weight: 750;
  }

  .henko-intro em {
    color: var(--text-highlight);
  }

  .henko-areas {
    display: grid;
    min-width: 0;
    gap: 0.65rem;
    align-content: start;
  }

  .henko-areas > h3 {
    margin: 0;
    color: var(--brand-aqua);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .henko-areas ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .henko-areas li {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.72rem;
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    background: transparent;
    color: var(--foreground);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  @media (width >= 860px) {
    .henko-header {
      grid-template-columns: 4rem minmax(0, 1fr);
      align-items: start;
    }

    .henko-lockup {
      grid-column: 2;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .henko-cta-link {
      white-space: nowrap;
    }

    .henko-body {
      grid-column: 1 / -1;
    }
  }

  @media (width <= 720px) {
    .henko-panel {
      border-radius: 1.5rem;
    }

    .henko-frame {
      padding: 1.25rem;
    }

    .henko-areas > h3 {
      letter-spacing: 0.12em;
    }

    .henko-header {
      gap: 0.9rem;
    }

    .henko-index {
      width: auto;
    }

    .henko-cta-link {
      white-space: normal;
    }

  }
</style>
