---
import { getCollection } from 'astro:content';

import BasePage from '@/components/BasePage.astro';
import ExperienceContainer from '@/components/Experience.astro';
import SectionContainer from '@/components/SectionContainer.astro';
import SectionPage from '@/components/SectionPage.astro';
import { getHomeCopy, localizeExperiences, type Locale } from '@/i18n/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = getHomeCopy(locale);
const entries = await getCollection('experiences');
const experiences = localizeExperiences(entries, locale);
---

<BasePage
  locale={locale}
  slug="experience"
  title={`${copy.experienceSection.pageTitle} | ${copy.title}`}
  description={copy.experienceSection.pageDescription}
>
  <SectionContainer>
    <SectionPage
      headingId="experience-title"
      number="01"
      title={copy.experienceSection.pageTitle}
      intro={copy.experienceSection.intro}
      panelClass="experience-panel"
    >
      <ExperienceContainer
        experiences={experiences}
        locale={locale}
        labels={copy.experienceLabels}
      />
    </SectionPage>
  </SectionContainer>
</BasePage>

<style>
  .experience-panel :global(.experience) {
    position: relative;
    z-index: 1;
  }
</style>
