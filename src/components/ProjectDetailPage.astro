---
import { render, type CollectionEntry } from 'astro:content';

import BasePage from '@/components/BasePage.astro';
import SectionContainer from '@/components/SectionContainer.astro';
import { getProjectStatusLabel, type PortfolioProject } from '@/data/projects';
import type { Locale } from '@/i18n/site';

interface Props {
  locale: Locale;
  project: PortfolioProject;
  editorial: CollectionEntry<'projects'>;
}

const { locale, project, editorial } = Astro.props;
const { Content } = await render(editorial);
const { title, description, focus, tags } = editorial.data;
const isSpanish = locale === 'es';
const projectsPath = isSpanish ? '/projects' : '/en/projects';
const repositoryLabel = isSpanish ? 'Repositorios públicos' : 'Public repositories';
const demoLabel = isSpanish ? 'Abrir demo pública' : 'Open public demo';
const privateRepositoryLabel = isSpanish
  ? 'El repositorio no está disponible públicamente.'
  : 'The repository is not publicly available.';
---

<BasePage
  locale={locale}
  slug={`projects/${project.slug}`}
  title={`${title} | ${isSpanish ? 'Caso de estudio' : 'Case study'}`}
  description={description}
>
  <SectionContainer>
    <article class="project-detail" aria-labelledby="project-detail-title">
      <header class="project-detail-header">
        <a class="back-link" href={projectsPath}>
          {isSpanish ? '← Volver a proyectos' : '← Back to projects'}
        </a>
        <p class="project-eyebrow">{focus}</p>
        <h1 id="project-detail-title">{title}</h1>
        <p class="project-lede">{description}</p>
        <ul class="project-meta" aria-label={isSpanish ? 'Estado del proyecto' : 'Project status'}>
          <li class={`project-status project-status-${project.projectStatus}`}>
            {getProjectStatusLabel(locale, project.projectStatus)}
          </li>
          {project.repositoryAvailability === 'private' && (
            <li class="repository-private">{isSpanish ? 'Repositorio privado' : 'Private repository'}</li>
          )}
          {project.repositoryAvailability === 'public' && (
            <li>{isSpanish ? 'Repositorios públicos' : 'Public repositories'}</li>
          )}
        </ul>
        <ul class="project-tags" aria-label={isSpanish ? 'Tecnologías y temas' : 'Technologies and topics'}>
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </header>

      <div class="project-detail-layout">
        <div class="project-content prose">
          <Content />
        </div>

        <aside class="project-evidence" aria-label={isSpanish ? 'Evidencia pública' : 'Public evidence'}>
          <div class="evidence-block">
            <p class="evidence-label">{isSpanish ? 'Qué demuestra' : 'What it demonstrates'}</p>
            <ul>
              {project.demonstrates.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          {(project.repositories.length > 0 || project.demo) && (
            <div class="evidence-block">
              <p class="evidence-label">{repositoryLabel}</p>
              <ul class="evidence-links">
                {project.repositories.map((repository) => (
                  <li>
                    <a href={repository.url} target="_blank" rel="noopener noreferrer">
                      {repository.label} ↗
                    </a>
                  </li>
                ))}
                {project.demo && (
                  <li>
                    <a href={project.demo} target="_blank" rel="noopener noreferrer">
                      {demoLabel} ↗
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )}

          {project.repositoryAvailability === 'private' && (
            <p class="private-note">{privateRepositoryLabel}</p>
          )}
        </aside>
      </div>
    </article>
  </SectionContainer>
</BasePage>

<style>
  .project-detail {
    position: relative;
    overflow: hidden;
    padding: clamp(1.25rem, 4vw, 3rem);
    border: 1px solid var(--border-subtle);
    border-radius: 2rem;
    background: var(--gradient-panel);
    box-shadow: var(--shadow-elevated);
  }

  .project-detail::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--gradient-panel-overlay);
    opacity: 0.9;
  }

  .project-detail-header,
  .project-detail-layout {
    position: relative;
    z-index: 1;
  }

  .project-detail-header {
    display: grid;
    gap: 0.9rem;
    max-width: 54rem;
  }

  .back-link,
  .prose :global(a),
  .evidence-links a {
    color: var(--brand-lime-soft);
    font-weight: 800;
    text-underline-offset: 0.2em;
  }

  .back-link {
    width: fit-content;
    font-size: 0.9rem;
  }

  .project-eyebrow,
  .evidence-label {
    margin: 0;
    color: var(--brand-aqua);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.2rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .project-lede {
    max-width: 48rem;
    margin: 0;
    color: var(--secondary-foreground);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .project-meta,
  .project-tags,
  .evidence-block ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-meta li,
  .project-tags li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    color: var(--secondary-foreground);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .project-status-in-development,
  .repository-private {
    border-color: var(--border-primary) !important;
    background: var(--surface-primary-soft);
    color: var(--foreground) !important;
  }

  .project-tags li {
    border-color: var(--border-accent);
    background: var(--surface-accent);
    color: var(--foreground);
    font-weight: 500;
  }

  .project-detail-layout {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 6vw, 4rem);
  }

  .project-content {
    max-width: 52rem;
    color: var(--secondary-foreground);
    line-height: 1.75;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2rem;
    color: var(--foreground);
    line-height: 1.2;
  }

  .prose :global(h2) {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .prose :global(h3) {
    font-size: 1.15rem;
  }

  .prose :global(p:first-child) {
    margin-top: 0;
  }

  .prose :global(li) {
    margin-block: 0.35rem;
  }

  .project-evidence {
    align-self: start;
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--border-faint);
    border-radius: 1.25rem;
    background: color-mix(in oklab, var(--surface-1) 84%, transparent);
  }

  .evidence-block {
    display: grid;
    gap: 0.75rem;
  }

  .evidence-block ul {
    display: grid;
    gap: 0.55rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .evidence-links {
    padding-left: 0 !important;
    list-style: none !important;
  }

  .private-note {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (width >= 900px) {
    .project-detail-layout {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 20rem);
      align-items: start;
    }

    .project-evidence {
      position: sticky;
      top: 1.5rem;
    }
  }
</style>
