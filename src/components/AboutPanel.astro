---
import type { getHomeCopy } from '@/i18n/site';

interface Props {
  copy: ReturnType<typeof getHomeCopy>['aboutSection'];
}

const { copy } = Astro.props;
---

<section id="about" class="about-panel" aria-labelledby="about-title">
  <div class="about-frame">
    <header class="about-header">
      <p><span>01</span>{copy.eyebrow}</p>
      <h2 id="about-title">{copy.title}</h2>
    </header>

    <p class="about-intro">{copy.intro}</p>

    <ol class="about-principles" aria-label={copy.eyebrow}>
      {copy.principles.map((principle, index) => {
        const itemId = `about-principle-${index + 1}`;
        const panelId = `${itemId}-panel`;
        const isInitiallyExpanded = index === 0;

        return (
          <li class="principle-item" data-expanded={isInitiallyExpanded}>
            <button
              class="principle-trigger"
              id={itemId}
              type="button"
              aria-expanded={isInitiallyExpanded}
              aria-controls={panelId}
              data-principle-trigger
            >
              <span class="principle-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="principle-title">{principle.label}</span>
              <span class="principle-chevron" aria-hidden="true"></span>
            </button>
            <div
              class="principle-panel"
              id={panelId}
              aria-labelledby={itemId}
              aria-hidden={!isInitiallyExpanded}
              inert={!isInitiallyExpanded}
              data-principle-panel
            >
              <div class="principle-panel-inner">
                <p>{principle.text}</p>
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  const principleItems = document.querySelectorAll<HTMLElement>('.about-principles .principle-item');

  for (const item of principleItems) {
    const trigger = item.querySelector<HTMLButtonElement>('[data-principle-trigger]');
    const panel = item.querySelector<HTMLElement>('[data-principle-panel]');

    if (!trigger || !panel) continue;

    trigger.addEventListener('click', () => {
      const shouldExpand = trigger.getAttribute('aria-expanded') !== 'true';

      for (const sibling of principleItems) {
        const siblingTrigger = sibling.querySelector<HTMLButtonElement>('[data-principle-trigger]');
        const siblingPanel = sibling.querySelector<HTMLElement>('[data-principle-panel]');

        if (!siblingTrigger || !siblingPanel) continue;

        const isExpanded = sibling === item && shouldExpand;
        sibling.dataset.expanded = String(isExpanded);
        siblingTrigger.setAttribute('aria-expanded', String(isExpanded));
        siblingPanel.setAttribute('aria-hidden', String(!isExpanded));
        siblingPanel.toggleAttribute('inert', !isExpanded);
      }
    });
  }
</script>

<style>
  .about-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 92% 12%, var(--glow-primary-soft), transparent 0 18rem),
      var(--gradient-panel);
    box-shadow: var(--shadow-elevated);
    backdrop-filter: blur(16px);
  }

  .about-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--gradient-panel-overlay-aqua);
  }

  .about-frame {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.2rem, 3vw, 2rem);
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .about-header {
    display: grid;
    gap: 0.75rem;
  }

  .about-header > p,
  .about-header > p > span,
  .principle-number {
    margin: 0;
    color: var(--brand-aqua);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .about-header > p {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .about-header > p > span {
    color: var(--text-highlight);
  }

  .about-header > p > span::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.82em;
    margin-left: 1rem;
    background: color-mix(in oklab, var(--brand-aqua-400) 34%, transparent);
    vertical-align: -0.08em;
  }

  .about-header > h2 {
    max-width: 28ch;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .about-intro {
    max-width: 78ch;
    margin: 0;
    color: color-mix(in oklab, var(--secondary-foreground) 86%, white 14%);
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.8;
    text-wrap: pretty;
  }

  .about-principles {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle-item {
    overflow: hidden;
    border: 1px solid var(--border-faint);
    border-radius: 1.1rem;
    background: var(--surface-1);
    box-shadow: var(--shadow-inset-soft);
    transition:
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .principle-item[data-expanded="true"] {
    border-color: var(--border-accent);
    background: color-mix(in oklab, var(--surface-1) 76%, var(--surface-accent-soft));
  }

  .principle-trigger {
    display: grid;
    width: 100%;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    padding: 1rem 1.1rem;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
  }

  .principle-trigger:focus-visible {
    outline: 2px solid var(--focus-outline);
    outline-offset: -3px;
    border-radius: inherit;
  }

  .principle-number {
    color: var(--brand-aqua);
  }

  .principle-title {
    color: var(--foreground);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .principle-chevron {
    width: 0.62rem;
    height: 0.62rem;
    margin-right: 0.15rem;
    border-right: 1.5px solid var(--brand-aqua);
    border-bottom: 1.5px solid var(--brand-aqua);
    transform: translateY(-0.15rem) rotate(45deg);
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .principle-item[data-expanded="true"] .principle-chevron {
    transform: translateY(0.15rem) rotate(225deg);
  }

  .principle-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 220ms ease;
    opacity: 0;
  }

  .principle-item[data-expanded="true"] .principle-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .principle-panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .principle-panel p {
    max-width: 72ch;
    margin: 0;
    padding: 0 1.1rem 1.1rem 4.25rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  @media (width <= 600px) {
    .about-panel {
      border-radius: 1.5rem;
    }

    .about-header > p,
    .about-header > p > span,
    .principle-number {
      letter-spacing: 0.12em;
    }

    .principle-trigger {
      grid-template-columns: 1.9rem minmax(0, 1fr) auto;
      gap: 0.65rem;
      padding: 0.95rem;
    }

    .principle-panel p {
      padding: 0 0.95rem 1rem 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .principle-item,
    .principle-chevron,
    .principle-panel {
      transition-duration: 0.01ms;
    }
  }
</style>
