---
import type { CollectionEntry } from 'astro:content';

import type { Locale } from '@/i18n/site';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
  readLabel: string;
}

const { entry, locale, readLabel } = Astro.props;
const { title, description, tags, channel, externalUrl, coverImage, coverAlt, slug } = entry.data;
// All article covers use this fixed source format; CSS scales it for each viewport.
const coverSize = { width: 1200, height: 600 } as const;
const articleSlug = slug.replace(/\.(?:es|en)$/, '');
const channelLabels = {
  site: { es: 'En este sitio', en: 'On this site' },
  medium: { es: 'Medium', en: 'Medium' },
  devto: { es: 'DEV.to', en: 'DEV.to' },
  linkedin: { es: 'LinkedIn', en: 'LinkedIn' },
} as const;
const channelLabel = channelLabels[channel][locale];
const isExternalChannel = channel !== 'site';
const href = isExternalChannel ? externalUrl : `/${locale === 'en' ? 'en/' : ''}blog/${articleSlug}`;
const externalReadLabels = {
  medium: { es: 'Leer en Medium', en: 'Read on Medium' },
  devto: { es: 'Leer en DEV.to', en: 'Read on DEV.to' },
  linkedin: { es: 'Leer en LinkedIn', en: 'Read on LinkedIn' },
} as const;
const label = isExternalChannel ? externalReadLabels[channel][locale] : readLabel;
---

<article class="blog-card">
  {coverImage ? (
    <img
      class="blog-cover"
      src={coverImage}
      alt={coverAlt ?? ''}
      width={coverSize.width}
      height={coverSize.height}
      loading="lazy"
      decoding="async"
    />
  ) : null}
  <div>
    <p class="blog-channel">{channelLabel}</p>
    <h2>{title}</h2>
    <p class="blog-description">{description}</p>
  </div>
  <ul class="blog-tags" aria-label={locale === 'es' ? 'Etiquetas' : 'Tags'}>
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  {href ? (
    <a
      class="blog-read"
      href={href}
      target={isExternalChannel ? '_blank' : undefined}
      rel={isExternalChannel ? 'noopener noreferrer' : undefined}
    >
      {label}<span aria-hidden="true"> ↗</span>
    </a>
  ) : null}
</article>

<style>
  .blog-card {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100%;
    overflow: hidden;
    padding: 1.35rem;
    border: 1px solid var(--border-faint);
    border-radius: 1.5rem;
    background: var(--surface-1);
    box-shadow: var(--shadow-inset-soft);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .blog-read {
    width: fit-content;
    max-width: 100%;
    color: var(--brand-lime-soft);
    font-weight: 800;
    text-decoration: none;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .blog-read:hover {
    text-decoration: underline;
  }

  .blog-read:focus-visible {
    outline: 2px solid var(--brand-aqua);
    outline-offset: 4px;
    border-radius: 0.2rem;
  }

  .blog-cover {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    background: var(--surface-2);
  }

  .blog-channel {
    margin: 0 0 0.5rem;
    color: var(--brand-aqua);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .blog-card h2 {
    margin: 0;
    color: var(--foreground);
    font-size: 1.25rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .blog-description {
    margin: 0.75rem 0 0;
    color: var(--muted-foreground);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-tags li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    background: var(--surface-accent);
    color: var(--foreground);
    font-size: 0.85rem;
  }

  @media (width >= 720px) {
    .blog-card:has(.blog-cover) {
      grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 1.15fr);
      grid-template-rows: 1fr auto auto;
      gap: 0;
      padding: 0;
    }

    .blog-card:has(.blog-cover) .blog-cover {
      grid-column: 1;
      grid-row: 1 / span 3;
      height: 100%;
      min-height: 100%;
      aspect-ratio: auto;
    }

    .blog-card:has(.blog-cover) > div {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
      padding: 1.5rem 1.5rem 0.75rem;
    }

    .blog-card:has(.blog-cover) .blog-tags {
      grid-column: 2;
      grid-row: 2;
      padding: 0 1.5rem 1rem;
    }

    .blog-card:has(.blog-cover) .blog-read {
      grid-column: 2;
      grid-row: 3;
      padding: 0 1.5rem 1.5rem;
    }
  }

  @media (width <= 719px) {
    .blog-card:has(.blog-cover) {
      padding: 0;
    }

    .blog-card:has(.blog-cover) > div,
    .blog-card:has(.blog-cover) .blog-tags,
    .blog-card:has(.blog-cover) .blog-read {
      margin-right: 1.35rem;
      margin-left: 1.35rem;
    }

    .blog-card:has(.blog-cover) > div {
      margin-top: 0.2rem;
    }

    .blog-card:has(.blog-cover) .blog-read {
      margin-bottom: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card { transition: none; }
  }
</style>
