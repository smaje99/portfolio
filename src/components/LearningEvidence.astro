---
import type { credentialsByLocale } from '@/data/credentials';
import type { getHomeCopy } from '@/i18n/site';

type Credentials = (typeof credentialsByLocale)[keyof typeof credentialsByLocale];

interface Props {
  copy: ReturnType<typeof getHomeCopy>['learningSection'];
  credentials: Credentials;
}

const { copy, credentials } = Astro.props;
const [thesisStart, thesisEnd] = credentials.thesis.split(credentials.thesisEmphasis);
---

<section class="learning-panel" aria-labelledby="learning-title">
  <header class="learning-header">
    <p>{copy.eyebrow}</p>
    <div>
      <h2 id="learning-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>
  </header>

  <div class="learning-thesis">
    <p>
      {thesisStart}<strong>{credentials.thesisEmphasis}</strong>{thesisEnd}
    </p>
    <ol aria-label={copy.practicesTitle}>
      {credentials.practices.map((practice) => (
        <li>{practice}</li>
      ))}
    </ol>
  </div>

  <div class="learning-grid">
    <section class="learning-block learning-pillars" aria-labelledby="learning-pillars-title">
      <h3 id="learning-pillars-title">{copy.pillarsTitle}</h3>
      <ol>
        {credentials.pillars.map((pillar) => (
          <li>
            <h4>{pillar.title}</h4>
            <p>{pillar.signal}</p>
            <div>
              {pillar.evidence.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <aside class="learning-block learning-highlights" aria-labelledby="learning-highlights-title">
      <h3 id="learning-highlights-title">{copy.highlightsTitle}</h3>
      <div class="highlight-list">
        {credentials.highlights.map((highlight) => (
          <article>
            <p>{highlight.area}</p>
            <h4>{highlight.title}</h4>
            <span>{highlight.issuer} · {highlight.date}</span>
            <small>{highlight.meaning}</small>
          </article>
        ))}
      </div>

      <div class="skill-cloud" aria-labelledby="learning-skills-title">
        <h3 id="learning-skills-title">{copy.skillsTitle}</h3>
        <div>
          {credentials.skills.map((skill) => (
            <span>{skill}</span>
          ))}
        </div>
      </div>

      <a href="http://linkedin.com/in/smaje" class="linkedin-link">
        {copy.linkedinLabel}
      </a>
    </aside>
  </div>
</section>

<style>
  .learning-panel {
    position: relative;
    overflow: hidden;
    padding: 1.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 16% 10%, var(--glow-accent), transparent 0 18rem),
      var(--gradient-panel);
    box-shadow: var(--shadow-elevated);
    backdrop-filter: blur(16px);
  }

  .learning-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--gradient-panel-overlay);
  }

  .learning-header,
  .learning-thesis,
  .learning-grid {
    position: relative;
    z-index: 1;
  }

  .learning-header {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1.35rem;
  }

  .learning-header > p {
    margin: 0;
    color: var(--brand-aqua);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .learning-header h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .learning-header div > p {
    margin: 0.75rem 0 0;
    max-width: 55rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .learning-thesis {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border-faint);
    border-radius: 1.35rem;
    padding: 1.15rem;
    background:
      linear-gradient(135deg, var(--surface-primary-soft), var(--surface-accent-soft)),
      var(--surface-1);
    box-shadow: var(--shadow-inset-soft);
  }

  .learning-thesis > p {
    margin: 0;
    color: var(--foreground);
    font-size: 1.05rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .learning-thesis strong {
    color: var(--text-highlight);
    font-weight: 800;
  }

  .learning-thesis ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }

  .learning-thesis li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .learning-thesis li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--brand-lime);
    box-shadow: 0 0 1rem var(--glow-primary);
  }

  .learning-block {
    border: 1px solid var(--border-faint);
    background: var(--surface-1);
    box-shadow: var(--shadow-inset-soft);
  }

  .learning-grid {
    display: grid;
    gap: 1rem;
  }

  .learning-block {
    padding: 1.1rem;
    border-radius: 1.5rem;
  }

  .learning-block h3 {
    margin: 0 0 1rem;
    color: color-mix(in oklab, var(--secondary-foreground) 92%, white 8%);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .learning-pillars ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .learning-pillars li {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .learning-pillars li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .learning-pillars h4,
  .learning-highlights h4 {
    margin: 0;
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.3;
  }

  .learning-pillars p {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .learning-pillars li > div,
  .skill-cloud > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .learning-pillars span,
  .skill-cloud span {
    border: 1px solid color-mix(in oklab, var(--brand-aqua-400) 22%, transparent);
    border-radius: 999px;
    padding: 0.35rem 0.58rem;
    color: var(--text-accent-soft);
    background: var(--surface-accent-soft);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .highlight-list {
    display: grid;
    gap: 0.7rem;
  }

  .highlight-list article {
    padding: 0.9rem;
    border: 1px solid color-mix(in oklab, var(--brand-aqua-400) 10%, transparent);
    border-radius: 1.1rem;
    background:
      var(--gradient-surface-accent),
      color-mix(in oklab, var(--brand-ink-950) 82%, transparent);
    box-shadow:
      0 0.85rem 1.8rem color-mix(in oklab, black 14%, transparent),
      inset 0 1px 0 color-mix(in oklab, white 3%, transparent);
  }

  .highlight-list p {
    margin: 0 0 0.45rem;
    color: var(--brand-aqua);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .highlight-list span {
    display: block;
    margin-top: 0.45rem;
    color: var(--muted-foreground);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .highlight-list small {
    display: block;
    margin-top: 0.55rem;
    color: color-mix(in oklab, var(--secondary-foreground) 82%, var(--muted-foreground) 18%);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .skill-cloud {
    margin-top: 1.25rem;
  }

  .linkedin-link {
    display: inline-flex;
    margin-top: 1.25rem;
    border: 1px solid var(--border-primary);
    border-radius: 999px;
    padding: 0.7rem 0.95rem;
    color: var(--primary);
    background: var(--surface-primary-soft);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .linkedin-link:hover {
    background: var(--surface-primary);
  }

  @media (width >= 860px) {
    .learning-header {
      grid-template-columns: minmax(8rem, 0.18fr) minmax(0, 0.82fr);
      align-items: start;
    }

    .learning-grid {
      grid-template-columns: minmax(0, 0.58fr) minmax(18rem, 0.42fr);
    }
  }

  @media (width <= 720px) {
    .learning-panel {
      padding: 1.25rem;
      border-radius: 1.5rem;
    }

    .learning-header > p,
    .learning-block h3 {
      letter-spacing: 0.12em;
    }
  }
</style>
