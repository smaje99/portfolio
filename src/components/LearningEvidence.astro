---
import type { credentialsByLocale } from '@/data/credentials';
import type { getHomeCopy } from '@/i18n/site';

type Credentials = (typeof credentialsByLocale)[keyof typeof credentialsByLocale];

interface Props {
  copy: ReturnType<typeof getHomeCopy>['learningSection'];
  credentials: Credentials;
}

const { copy, credentials } = Astro.props;
---

<section class="learning-panel" aria-labelledby="learning-title">
  <header class="learning-header">
    <p>{copy.eyebrow}</p>
    <div>
      <h2 id="learning-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>
  </header>

  <div class="learning-inventory" aria-label={copy.inventoryTitle}>
    <article>
      <span>{credentials.inventory.totalEntries}</span>
      <p>{credentials.inventory.providers}</p>
    </article>
    <article>
      <span>{credentials.inventory.strongestSources}</span>
      <p>{credentials.inventory.evidencePolicy}</p>
    </article>
  </div>

  <div class="learning-grid">
    <section class="learning-block learning-pillars" aria-labelledby="learning-pillars-title">
      <h3 id="learning-pillars-title">{copy.pillarsTitle}</h3>
      <ol>
        {credentials.pillars.map((pillar) => (
          <li>
            <h4>{pillar.title}</h4>
            <p>{pillar.signal}</p>
            <div>
              {pillar.evidence.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <aside class="learning-block learning-highlights" aria-labelledby="learning-highlights-title">
      <h3 id="learning-highlights-title">{copy.highlightsTitle}</h3>
      <div class="highlight-list">
        {credentials.highlights.map((highlight) => (
          <article>
            <p>{highlight.area}</p>
            <h4>{highlight.title}</h4>
            <span>{highlight.issuer} · {highlight.date}</span>
          </article>
        ))}
      </div>

      <div class="skill-cloud" aria-labelledby="learning-skills-title">
        <h3 id="learning-skills-title">{copy.skillsTitle}</h3>
        <div>
          {credentials.skills.map((skill) => (
            <span>{skill}</span>
          ))}
        </div>
      </div>

      <a href="http://linkedin.com/in/smaje" class="linkedin-link">
        {copy.linkedinLabel}
      </a>
    </aside>
  </div>
</section>

<style>
  .learning-panel {
    position: relative;
    overflow: hidden;
    padding: 1.75rem;
    border: 1px solid rgb(75 131 140 / 36%);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 16% 10%, rgb(127 221 211 / 14%), transparent 0 18rem),
      linear-gradient(180deg, rgb(11 43 49 / 88%), rgb(7 34 40 / 94%));
    box-shadow:
      0 24px 80px rgb(0 0 0 / 28%),
      inset 0 1px 0 rgb(255 255 255 / 4%);
    backdrop-filter: blur(16px);
  }

  .learning-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgb(224 255 79 / 0%) 0%, rgb(224 255 79 / 6%) 46%, rgb(127 221 211 / 0%) 100%);
  }

  .learning-header,
  .learning-inventory,
  .learning-grid {
    position: relative;
    z-index: 1;
  }

  .learning-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .learning-header > p {
    margin: 0;
    color: var(--brand-aqua);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .learning-header h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .learning-header div > p {
    margin: 0.75rem 0 0;
    max-width: 55rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .learning-inventory {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .learning-inventory article,
  .learning-block {
    border: 1px solid rgb(75 131 140 / 24%);
    background: rgb(4 25 30 / 42%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 3%);
  }

  .learning-inventory article {
    padding: 1.05rem;
    border-radius: 1.35rem;
  }

  .learning-inventory span {
    display: block;
    color: var(--foreground);
    font-weight: 800;
    line-height: 1.35;
  }

  .learning-inventory p {
    margin: 0.5rem 0 0;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .learning-grid {
    display: grid;
    gap: 1rem;
  }

  .learning-block {
    padding: 1.1rem;
    border-radius: 1.5rem;
  }

  .learning-block h3 {
    margin: 0 0 1rem;
    color: color-mix(in srgb, var(--secondary-foreground) 92%, white 8%);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .learning-pillars ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .learning-pillars li {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgb(75 131 140 / 18%);
  }

  .learning-pillars li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .learning-pillars h4,
  .learning-highlights h4 {
    margin: 0;
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.3;
  }

  .learning-pillars p {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .learning-pillars li > div,
  .skill-cloud > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .learning-pillars span,
  .skill-cloud span {
    border: 1px solid rgb(127 221 211 / 22%);
    border-radius: 999px;
    padding: 0.35rem 0.58rem;
    color: color-mix(in srgb, var(--brand-aqua) 74%, white 26%);
    background: rgb(127 221 211 / 7%);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .highlight-list {
    display: grid;
    gap: 0.7rem;
  }

  .highlight-list article {
    padding: 0.9rem;
    border-radius: 1.1rem;
    background: rgb(7 34 40 / 64%);
  }

  .highlight-list p {
    margin: 0 0 0.45rem;
    color: var(--brand-aqua);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .highlight-list span {
    display: block;
    margin-top: 0.45rem;
    color: var(--muted-foreground);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .skill-cloud {
    margin-top: 1.25rem;
  }

  .linkedin-link {
    display: inline-flex;
    margin-top: 1.25rem;
    border: 1px solid rgb(224 255 79 / 36%);
    border-radius: 999px;
    padding: 0.7rem 0.95rem;
    color: var(--primary);
    background: rgb(224 255 79 / 7%);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .linkedin-link:hover {
    background: rgb(224 255 79 / 12%);
  }

  @media (width >= 860px) {
    .learning-header {
      grid-template-columns: 4rem minmax(0, 1fr);
      align-items: start;
    }

    .learning-inventory {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    }

    .learning-grid {
      grid-template-columns: minmax(0, 0.58fr) minmax(18rem, 0.42fr);
    }
  }

  @media (width <= 720px) {
    .learning-panel {
      padding: 1.25rem;
      border-radius: 1.5rem;
    }

    .learning-header > p,
    .learning-block h3 {
      letter-spacing: 0.12em;
    }
  }
</style>
