---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import BasePage from '@/components/BasePage.astro';
import SectionContainer from '@/components/SectionContainer.astro';
import SectionPage from '@/components/SectionPage.astro';
import type { Locale } from '@/i18n/site';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { Content } = await render(entry);
const { title, description, tags } = entry.data;
const copy = locale === 'es' ? 'Artículo' : 'Article';
---

<BasePage locale={locale} slug="blog" title={`${title} | ${copy}`} description={description}>
  <SectionContainer>
    <SectionPage headingId="blog-post-title" number="04" title={title} intro={description}>
      <article class="blog-post">
        <ul class="blog-tags" aria-label={locale === 'es' ? 'Etiquetas' : 'Tags'}>
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <div class="blog-content"><Content /></div>
      </article>
    </SectionPage>
  </SectionContainer>
</BasePage>

<style>
  .blog-post {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    max-width: 48rem;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-tags li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    background: var(--surface-accent);
    color: var(--foreground);
    font-size: 0.85rem;
  }

  .blog-content {
    color: var(--secondary-foreground);
    line-height: 1.75;
  }

  .blog-content :global(h2),
  .blog-content :global(h3) {
    color: var(--foreground);
    line-height: 1.25;
  }

  .blog-content :global(a) {
    color: var(--brand-lime-soft);
  }
</style>
