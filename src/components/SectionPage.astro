---
interface Props {
  headingId: string;
  number: string;
  title: string;
  intro: string;
  panelClass?: string;
}

const { headingId, number, title, intro, panelClass = '' } = Astro.props;
---

<section class:list={['section-page', panelClass]} aria-labelledby={headingId}>
  <header class="section-page-header">
    <p>{number}</p>
    <div class="section-page-heading-copy">
      <h1 id={headingId}>{title}</h1>
      <p>{intro}</p>
    </div>
  </header>

  <slot />
</section>

<style>
  .section-page {
    position: relative;
    overflow: hidden;
    padding: 1.75rem;
    border: 1px solid rgb(75 131 140 / 36%);
    border-radius: 2rem;
    background:
      linear-gradient(180deg, rgb(11 43 49 / 88%), rgb(7 34 40 / 94%));
    box-shadow:
      0 24px 80px rgb(0 0 0 / 28%),
      inset 0 1px 0 rgb(255 255 255 / 4%);
    backdrop-filter: blur(16px);
  }

  .section-page::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgb(224 255 79 / 0%) 0%, rgb(224 255 79 / 6%) 46%, rgb(127 221 211 / 0%) 100%);
    opacity: 0.9;
  }

  .section-page-header {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .section-page-header > p {
    margin: 0;
    color: var(--brand-aqua);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-page-heading-copy {
    display: grid;
    gap: 0.75rem;
  }

  .section-page-heading-copy > h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .section-page-heading-copy > p {
    margin: 0;
    max-width: 54rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  @media (width >= 860px) {
    .section-page-header {
      grid-template-columns: 4rem minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (width <= 720px) {
    .section-page {
      padding: 1.25rem;
      border-radius: 1.5rem;
    }
  }
</style>
