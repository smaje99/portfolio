---
import "@fontsource-variable/onest";
import "normalize.css";
import "@/styles/global.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import type { Locale } from "@/i18n/site";

interface Props {
  title: string;
  description: string;
  brandName: string;
  homeHref: string;
  homeLinkLabel: string;
  menuLabel: string;
  closeMenuLabel: string;
  lang: Locale;
  canonicalPath: string;
  alternates: { hreflang: string; href: string }[];
  navigation: { label: string; href: string }[];
  languageSwitcherLabel: string;
  languageLabel: string;
  languageSwitcherHref: string;
  languageSwitcherLocale: Locale;
  robots?: string;
}

const {
  title,
  description,
  brandName,
  homeHref,
  homeLinkLabel,
  menuLabel,
  closeMenuLabel,
  lang,
  canonicalPath,
  alternates,
  navigation,
  languageSwitcherLabel,
  languageLabel,
  languageSwitcherHref,
  languageSwitcherLocale,
  robots = 'index,follow',
} = Astro.props;

const resolveHref = (href: string) => {
  if (!Astro.site) return href;
  return new URL(href, Astro.site).toString();
};

const rssHref = Astro.site ? new URL('rss.xml', Astro.site).toString() : '/rss.xml';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={resolveHref(canonicalPath)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'es' ? 'RSS del blog de Sergio Majé' : 'Sergio Majé blog RSS'}
      href={rssHref}
    />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={resolveHref(alternate.href)}
      />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:url" content={resolveHref(canonicalPath)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="layout-background"></div>

    <Header
      brandName={brandName}
      homeHref={homeHref}
      homeLinkLabel={homeLinkLabel}
      menuLabel={menuLabel}
      closeMenuLabel={closeMenuLabel}
      navigation={navigation}
      languageSwitcherLabel={languageSwitcherLabel}
      languageLabel={languageLabel}
      languageSwitcherHref={languageSwitcherHref}
      languageSwitcherLocale={languageSwitcherLocale}
    />
    <slot />
    <Footer
      locale={lang}
      brandName={brandName}
      homeHref={homeHref}
      homeLinkLabel={homeLinkLabel}
      navigation={navigation}
    />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
  }

  .layout-background {
    position: fixed;
    inset: 0;
    top: 0;
    z-index: -2;

    width: 100vw;
    height: 100dvh;

    background:
      radial-gradient(circle at 18% 14%, color-mix(in oklab, var(--brand-lime-500) 18%, transparent), transparent 0 24rem),
      radial-gradient(circle at 82% 6%, color-mix(in oklab, var(--brand-aqua-400) 15%, transparent), transparent 0 22rem),
      linear-gradient(180deg, color-mix(in oklab, var(--brand-ink-900) 94%, transparent), var(--brand-ink-950));
    isolation: isolate;
  }

  .layout-background::before,
  .layout-background::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .layout-background::before {
    background-image:
      linear-gradient(var(--brand-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--brand-grid) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: linear-gradient(180deg, var(--mask-strong), transparent 88%);
  }

  .layout-background::after {
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--brand-lime-500) 0%, transparent) 24%,
      color-mix(in oklab, var(--brand-lime-500) 6%, transparent) 52%,
      color-mix(in oklab, var(--brand-lime-500) 0%, transparent) 74%
    );
    opacity: 0.85;
    mix-blend-mode: screen;
  }
</style>
